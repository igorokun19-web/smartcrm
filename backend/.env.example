# ==============================================================
# SmartCRM Backend - Environment Variables
# ==============================================================
# 🔒 SECURITY: DO NOT COMMIT .env FILE TO GITHUB!
# This is an example - copy to .env and fill with your values

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Port to run the server on (default: 3001)
PORT=3001

# Environment mode (development, production, test)
NODE_ENV=development

# Frontend URL for CORS and email links
FRONTEND_URL=http://localhost:5175

# Comma-separated CORS origins (recommended in production)
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Trust proxy hops (Render/NGINX typically 1)
TRUST_PROXY=1

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================

# JWT Secret - GENERATE A STRONG SECRET FOR PRODUCTION!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ REQUIRED for production - set on Render dashboard
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================================
# EMAIL CONFIGURATION (for password recovery)
# ============================================================

# SMTP Email Service
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password  # Use Gmail App Password, not your regular password!
EMAIL_FROM=noreply@myservices.com

# ============================================================
# DATABASE
# ============================================================

# SQLite database location (default: crm.db in current directory)
# Leave empty to use default
DB_PATH=./crm.db

# ============================================================
# BILLING (STRIPE)
# ============================================================

# Stripe secret API key (server-side only)
# Starts with: sk_test_... (or sk_live_... in production)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret from Stripe Dashboard
# Starts with: whsec_...
STRIPE_WEBHOOK_SECRET=

# Optional Stripe webhook signature tolerance in seconds (default 300)
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Stripe recurring price IDs used for checkout
# Starts with: price_...
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Optional: value threshold before trial extension is blocked
# Default in code: 5
VALUE_GATE_MIN_LEADS=5

# Optional: billing descriptor shown to customers
# Default in code: RYNEX
BILLING_DESCRIPTOR=RYNEX

# Optional: never seed demo users in production unless explicitly needed
ALLOW_DEMO_SEED=false

# ============================================================
# SECURITY NOTES
# ============================================================

# 🔐 For Local Development:
# 1. Copy this file to .env
# 2. Fill in development values
# 3. Never commit .env to version control

# 🔐 For Production (Render):
# 1. Generate strong JWT_SECRET:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2. Set all variables in Render Dashboard → Settings → Environment Variables
# 3. Use Gmail App Password (not your main password)
# 4. Keep all secrets out of code and version control
# 5. Keep STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET ONLY on backend env
# 6. Verify webhook signatures using STRIPE_WEBHOOK_SECRET (already enforced in code)
# 7. Rotate Stripe secrets immediately if exposed

# ==============================================================
